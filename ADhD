                    <div class="p-3 bg-white rounded-xl">
                        <p class="font-bold mb-1 text-sage-700">2. 今天我自己值得肯定的一個地方：</p>
                        <p class="text-slate-400 italic">例：當孩子發脾氣時，我先做了三次深呼吸，沒有跟著失控。</p>
                    </div>
                    <div class="p-3 bg-white rounded-xl">
                        <p class="font-bold mb-1 text-sage-700">3. 今晚給自己的給力小獎勵：</p>
                        <p class="text-slate-400 italic">例：睡前喝一杯熱洋甘菊茶，安靜聽音樂 10 分鐘。</p>
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <button onclick="closeModal('modal-journal')" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-600 font-bold text-xs">關閉</button>
                <button onclick="window.print()" class="px-5 py-2 rounded-xl bg-sage-600 hover:bg-sage-700 text-white font-bold text-xs shadow-md"><i class="fa-solid fa-print mr-1"></i> 列印此表單</button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT INTERACTIVE LOGIC -->
    <script>
        // ----------------------------------------------------
        // 1. Mobile Menu Toggle
        // ----------------------------------------------------
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Close mobile menu on clicking link
        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // ----------------------------------------------------
        // 2. ADHD Types Tab Switcher
        // ----------------------------------------------------
        function switchAdhdTab(type) {
            // Hide all tab panels
            document.querySelectorAll('.adhd-tab-panel').forEach(panel => panel.classList.add('hidden'));
            
            // Reset button styles
            document.querySelectorAll('.adhd-tab-btn').forEach(btn => {
                btn.classList.remove('bg-brand-600', 'text-white', 'shadow-sm');
                btn.classList.add('bg-slate-100', 'text-slate-600');
            });

            // Activate chosen tab
            document.getElementById(`tab-content-${type}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-btn-${type}`);
            activeBtn.classList.remove('bg-slate-100', 'text-slate-600');
            activeBtn.classList.add('bg-brand-600', 'text-white', 'shadow-sm');
        }

        // ----------------------------------------------------
        // 3. Myth Cards Flip/Toggle Effect
        // ----------------------------------------------------
        function toggleMythCard(card) {
            const front = card.querySelector('.myth-front');
            const back = card.querySelector('.myth-back');

            if (front.classList.contains('hidden')) {
                front.classList.remove('hidden');
                back.classList.add('hidden');
            } else {
                front.classList.add('hidden');
                back.classList.remove('hidden');
            }
        }

        // ----------------------------------------------------
        // 4. Interactive Visual Timer Logic
        // ----------------------------------------------------
        let timerDuration = 15 * 60; // default 15 minutes
        let timerRemaining = timerDuration;
        let timerInterval = null;
        let isTimerRunning = false;
        let timerMode = 'focus'; // 'focus' or 'break'

        const timerCircle = document.getElementById('timer-circle');
        const timerDisplay = document.getElementById('timer-display');
        const timerStatusText = document.getElementById('timer-status-text');
        const timerStartBtn = document.getElementById('timer-start-btn');
        const timerStartIcon = document.getElementById('timer-start-icon');
        const timerStartLabel = document.getElementById('timer-start-label');

        const totalCircleDash = 263.89; // 2 * PI * r (r=42)

        function updateTimerUI() {
            const minutes = Math.floor(timerRemaining / 60);
            const seconds = timerRemaining % 60;
            timerDisplay.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

            // Calculate DashOffset for Visual Progress
            const fraction = timerRemaining / timerDuration;
            const dashoffset = totalCircleDash * (1 - fraction);
            timerCircle.style.strokeDashoffset = dashoffset;
        }

        function setTimerMode(mode) {
            resetTimer();
            timerMode = mode;

            const focusBtn = document.getElementById('timer-mode-focus');
            const breakBtn = document.getElementById('timer-mode-break');

            if (mode === 'focus') {
                timerDuration = 15 * 60;
                timerStatusText.textContent = '寫作業 / 專注中';
                timerCircle.setAttribute('stroke', '#f59e0b'); // amber color
                focusBtn.className = 'px-4 py-1.5 rounded-full text-xs font-bold transition bg-amber-500 text-white shadow-sm';
                breakBtn.className = 'px-4 py-1.5 rounded-full text-xs font-bold transition bg-slate-100 text-slate-600';
            } else {
                timerDuration = 5 * 60;
                timerStatusText.textContent = '伸展吃點心 / 休息中';
                timerCircle.setAttribute('stroke', '#10b981'); // green color
                breakBtn.className = 'px-4 py-1.5 rounded-full text-xs font-bold transition bg-emerald-500 text-white shadow-sm';
                focusBtn.className = 'px-4 py-1.5 rounded-full text-xs font-bold transition bg-slate-100 text-slate-600';
            }

            timerRemaining = timerDuration;
            updateTimerUI();
        }

        function toggleTimer() {
            if (isTimerRunning) {
                // Pause Timer
                clearInterval(timerInterval);
                isTimerRunning = false;
                timerStartIcon.className = 'fa-solid fa-play';
                timerStartLabel.textContent = '繼續計時';
                timerStartBtn.className = 'px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-sm shadow-md transition flex items-center gap-2';
            } else {
                // Start Timer
                isTimerRunning = true;
                timerStartIcon.className = 'fa-solid fa-pause';
                timerStartLabel.textContent = '暫停計時';
                timerStartBtn.className = 'px-6 py-2.5 rounded-xl bg-slate-700 hover:bg-slate-800 text-white font-bold text-sm shadow-md transition flex items-center gap-2';

                timerInterval = setInterval(() => {
                    if (timerRemaining > 0) {
                        timerRemaining--;
                        updateTimerUI();
                    } else {
                        clearInterval(timerInterval);
                        isTimerRunning = false;
                        timerStartIcon.className = 'fa-solid fa-play';
                        timerStartLabel.textContent = '重新開始';
                        alert(timerMode === 'focus' ? '🎉 太棒了！專注時間結束！快去休息 5 分鐘吧！' : '⏰ 休息時間到了，準備開始下一個微型專注囉！');
                    }
                }, 1000);
            }
        }

        function resetTimer() {
            clearInterval(timerInterval);
            isTimerRunning = false;
            timerRemaining = timerDuration;
            timerStartIcon.className = 'fa-solid fa-play';
            timerStartLabel.textContent = '開始計時';
            timerStartBtn.className = 'px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-sm shadow-md transition flex items-center gap-2';
            updateTimerUI();
        }

        // ----------------------------------------------------
        // 5. Teacher Letter Generator Logic
        // ----------------------------------------------------
        function generateTeacherLetter() {
            const name = document.getElementById('child-name').value.trim() || '孩子';
            const grade = document.getElementById('child-grade').value.trim() || '班級';

            // Selected strengths
            const strengths = Array.from(document.querySelectorAll('.strength-cb:checked')).map(cb => cb.value);
            // Selected challenges
            const challenges = Array.from(document.querySelectorAll('.challenge-cb:checked')).map(cb => cb.value);
            // Selected strategies
            const strategies = Array.from(document.querySelectorAll('.strategy-cb:checked')).map(cb => cb.value);

            let letter = `尊敬的老師 您好：

我是 ${grade} ${name} 的家長。非常感謝您悉心帶領班級！開學之際，想向您簡單說明 ${name} 的特質，希望能與您建立良好的親師合作關係。

【孩子的閃光點】
${strengths.length > 0 ? strengths.map(s => `・${s}`).join('\n') : '・對新事物充滿好奇心、熱心助人'}

【孩子在學習與適應上的特質】
${name} 的大腦執行功能較為活躍，在校期間可能偶爾會有以下情況：
${challenges.length > 0 ? challenges.map(c => `・${c}`).join('\n') : '・需要明確簡短的指令引導'}

【建議可嘗試的教學支援】
若情況許可，想懇請老師在日常課堂中給予以下微調協助：
${strategies.length > 0 ? strategies.map(st => `・${st}`).join('\n') : '・給予溫柔的眼神提示'}

我們在家中也會積極搭配「視覺化計時器」與正向獎勵卡輔導。若 ${name} 在學校有任何需要家長配合調整的地方，歡迎隨時透過聯絡簿或電話與我聯繫。

再次謝謝老師的包容與辛勞！

${name} 的家長 敬上`;

            document.getElementById('letter-output').textContent = letter;
        }

        function copyLetterText() {
            const text = document.getElementById('letter-output').textContent;
            
            // Clipboard fallback
            const tempInput = document.createElement('textarea');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            // Toast feedback
            const toast = document.getElementById('copy-toast');
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 3000);
        }

        function printLetter() {
            window.print();
        }

        // ----------------------------------------------------
        // 6. Interactive Parent Stress Quiz
        // ----------------------------------------------------
        function calculateQuizResult() {
            const form = document.getElementById('quiz-form');
            const q1 = form.querySelector('input[name="q1"]:checked');
            const q2 = form.querySelector('input[name="q2"]:checked');
            const q3 = form.querySelector('input[name="q3"]:checked');
            const q4 = form.querySelector('input[name="q4"]:checked');

            if (!q1 || !q2 || !q3 || !q4) {
                alert('請完整回答所有 4 個問題，才能產生成效分析喔！');
                return;
            }

            const totalScore = parseInt(q1.value) + parseInt(q2.value) + parseInt(q3.value) + parseInt(q4.value);

            document.getElementById('quiz-form').classList.add('hidden');
            const resultBox = document.getElementById('quiz-result');
            resultBox.classList.remove('hidden');

            const resultTitle = document.getElementById('result-title');
            const resultDesc = document.getElementById('result-desc');
            const resultTips = document.getElementById('result-tips');

            if (totalScore <= 6) {
                resultTitle.textContent = '綠色燈號：能量充沛，正向陪伴大使！';
                resultDesc.textContent = '太讚了！您目前擁有相當良好的心態與調節策略，能夠同理孩子的特質並給予支持。請繼續保持這份溫暖！';
                resultTips.innerHTML = `
                    <li>分享您的教養經驗給其他有需要的家長，給予彼此支持。</li>
                    <li>持續練習「微型喘息」，維持好自己的能量場。</li>
                `;
            } else if (totalScore <= 9) {
                resultTitle.textContent = '黃色燈號：微度焦慮，需要補充育兒電量！';
                resultDesc.textContent = '您做得已經很棒了！陪伴 ADHD 孩子確實需要花費巨大的耐心。最近您可能稍微感到有些疲憊。';
                resultTips.innerHTML = `
                    <li>下載本站的「視覺化作息表」，減少重複口頭催促的次數。</li>
                    <li>每天給自己 15 分鐘「無負擔靜心時間」，喝杯茶或散步。</li>
                    <li>練習用「具體讚美」代替指責，重塑正向互動循環。</li>
                `;
            } else {
                resultTitle.textContent = '紅色燈號：壓力緊繃，請先給自己一個溫暖緊抱！';
                resultDesc.textContent = '辛苦您了！您目前承受了相當高的育兒壓力。請記住，有壓力是極其正常的，您不需要獨自扛下所有責任。';
                resultTips.innerHTML = `
                    <li>先暫停檢討孩子，今晚放慢節奏，與另一半或親友協調接手照顧 1 小時。</li>
                    <li>使用本站「寫給老師的一封信產生器」，尋求學校專業力量的共同合作。</li>
                    <li>必要時可尋求兒童心智科或諮商心理師的家長諮詢服務，您並不孤單！</li>
                `;
            }
        }

        function resetQuiz() {
            document.getElementById('quiz-form').reset();
            document.getElementById('quiz-form').classList.remove('hidden');
            document.getElementById('quiz-result').classList.add('hidden');
        }

        // ----------------------------------------------------
        // 7. Modal Control Helpers
        // ----------------------------------------------------
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        // Initialize defaults on load
        window.onload = function() {
            updateTimerUI();
            generateTeacherLetter();
        };
    </script>
</body>
</html>
